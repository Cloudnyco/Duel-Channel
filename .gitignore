# --- dependencies ---------------------------------------------------------------------------------
node_modules/

# --- the pages built from the asset pack (npm run build) ------------------------------------------
public/*
!public/.gitkeep
# --- the display fonts: their authors' free-font terms; fetched at build time (tools/build-page.mjs) --
assets/fonts/
*.woff2
*.otf
*.ttf
# --- loose audio / model files: only the asset pack's own (assets/) belong in the repository ----------
*.ogg
!assets/audio/*.ogg
*.wav
*.mp3
*.skel
*.atlas

# --- caches, logs, reports --------------------------------------------------------------------------
.cache/
logs/
*.log
test/out/

# --- per-machine config -----------------------------------------------------------------------------
.env
.env.*

# --- OS / editor clutter ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
.claude/
